module(
    name = "any-sketch",
    repo_name = "any_sketch",
)

BORINGSSL_VERSION = "0.0.0-20230215-5c22014"

# Bazel Central Registry modules.
bazel_dep(
    name = "rules_cc",
    version = "0.0.17",
)
bazel_dep(
    name = "protobuf",
    version = "27.3",
    repo_name = "com_google_protobuf",
)
bazel_dep(
    name = "abseil-cpp",
    version = "20240722.0.bcr.2",
    repo_name = "com_google_absl",
)
bazel_dep(
    name = "googletest",
    version = "1.15.2",
    repo_name = "com_google_googletest",
)
bazel_dep(
    name = "glog",
    version = "0.7.1",
    repo_name = "com_github_google_glog",
)
bazel_dep(
    name = "boringssl",
    version = BORINGSSL_VERSION,
)

# DO_NOT_SUBMIT (testing)
# Not used directly, but private-join-and-compute@0.0.0-20230417-e028e59 brings rules_go@0.39.1 which is
# incompatible with bazel 9.
bazel_dep(
    name = "rules_go",
    version = "0.60.0",
)

# WFA registry modules.
bazel_dep(
    name = "common-cpp",
    version = "0.11.0",
    repo_name = "wfa_common_cpp",
)
# DO_NOT_SUBMIT: use new release version
git_override(
    module_name = "common-cpp",
    commit = "510cc23c01791cfe4f64e543ad145e1ae41534de",
    remote = "https://github.com/world-federation-of-advertisers/common-cpp.git",
)
bazel_dep(
    name = "private-join-and-compute",
    version = "0.0.0-20230417-e028e59",
    repo_name = "com_google_private_join_and_compute",
)

single_version_override(
    module_name = "boringssl",
    version = BORINGSSL_VERSION,
)
